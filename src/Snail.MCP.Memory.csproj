<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RollForward>LatestMajor</RollForward>
        <!--
            Published into ~/.snail-mcp with -p:Install=true (Snail.Toolkit.Mcp.Build), framework-dependent: Entity
            Framework and the ONNX runtime keep it from being a native program.
        -->
        <SnailMcpName>Snail.MCP.Memory</SnailMcpName>
        <!-- One server for every session, kept running by launchd: deploy/com.snail.mcp.memory.plist. -->
        <SnailMcpLaunchAgent>$(MSBuildProjectDirectory)/../deploy/com.snail.mcp.memory.plist</SnailMcpLaunchAgent>
<!--        <Version>0.1.1</Version>-->
    </PropertyGroup>

    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>snail-mcp-memory</ToolCommandName>
        <PackageType>McpServer</PackageType>
        <PackageId>Snail.MCP.Memory</PackageId>
        <PackageVersion>0.2.0</PackageVersion>
        <Authors>orldev</Authors>
        <Description>MCP server that gives AI agents universal long-term local memory: semantically searchable records (facts, decisions, lessons, tasks) per project plus a typed knowledge graph of directed relations. SQLite with sqlite-vec vector search, in-process ONNX embeddings (multilingual), cross-project experience transfer, record lifecycle with supersession and review.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;memory;knowledge-graph;vector-search;sqlite-vec;embeddings</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Memory</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Memory</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false"/>
        <None Include="..\.mcp\server.json" Pack="true" PackagePath="/.mcp/" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.VectorData.PgVector" />
      <PackageReference Include="CommunityToolkit.VectorData.SqliteVec" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
      <PackageReference Include="Snail.Toolkit.Mcp.Hosting" />
      <PackageReference Include="Snail.Toolkit.Mcp.Build" PrivateAssets="all" />
      <PackageReference Include="Microsoft.ML.OnnxRuntime" />
      <PackageReference Include="Microsoft.ML.Tokenizers" />
      <PackageReference Include="ModelContextProtocol" />
      <PackageReference Include="Snail.Toolkit.Mcp.Http" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Snail.MCP.Memory.Tests" />
    </ItemGroup>

</Project>
