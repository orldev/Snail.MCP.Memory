<Project Sdk="Snail.Sdk.Mcp">

    <!--
        Framework-dependent: Entity Framework and the ONNX runtime keep it from being a native program. Over stdio for
        a client that starts its own, over HTTP as the one server of the machine (Snail.Sdk.Mcp.Http).
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <SnailMcpNative>false</SnailMcpNative>
        <SnailMcpTransport>Both</SnailMcpTransport>
        <!--
            Culture data stays: the SentencePiece tokenizer normalizes text (NFKC) before embedding it, and in invariant
            mode string normalization leaves compatibility characters as they are, so the same text would embed differently.
        -->
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- One server for every session, kept running by launchd: deploy/s3l.mcp.memory.plist, found by its name. -->
<!--        <Version>0.1.1</Version>-->
    </PropertyGroup>

    <PropertyGroup>
        <PackageVersion>0.2.0</PackageVersion>
        <Description>MCP server that gives AI agents universal long-term local memory: semantically searchable records (facts, decisions, lessons, tasks) per project plus a typed knowledge graph of directed relations. SQLite with sqlite-vec vector search, in-process ONNX embeddings (multilingual), cross-project experience transfer, record lifecycle with supersession and review.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;memory;knowledge-graph;vector-search;sqlite-vec;embeddings</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Memory</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Memory</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.VectorData.PgVector" />
        <PackageReference Include="CommunityToolkit.VectorData.SqliteVec" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" />
        <PackageReference Include="Microsoft.ML.Tokenizers" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Memory.Tests" />
    </ItemGroup>

</Project>
